<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="ledger"
        Arguments=""
        InstallLocation="C:\Program Files\Manuc Design\Ledger">
    </Installer>
    <PackageInformation
        PackageName="Ledger"
        PackageDisplayName="Ledger"
        PublisherName="CN=Manuc Design"
        PublisherDisplayName="Manuc Design"
        Version="0.1.0.0"
        PackageDescription="A 3D printing cost estimation tool">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="design.manuc.ledger"
                Description="A 3D printing cost estimation tool"
                DisplayName="Ledger"
                ExecutableName="ledger"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Ledger</DisplayName>
            <PublisherDisplayName>Manuc Design</PublisherDisplayName>
            <Description>A 3D printing cost estimation tool</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="ledger.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
